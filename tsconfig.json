  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["DOM", "ES2020"],
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noImplicitAny": true,
    "types": ["node"], "noEmit": true
